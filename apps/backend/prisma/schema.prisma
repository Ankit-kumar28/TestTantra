// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ClubStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum MembershipRole {
  ADMIN
  COORDINATOR
  MEMBER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REMOVED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExamAccessMode {
  SCHEDULED
  DYNAMIC
}

enum ExamSessionStatus {
  SCHEDULED
  OPEN
  CLOSED
  CANCELLED
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  TRUE_FALSE
  FILL_BLANK
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  ABANDONED
}

//********************************************************************************
//---------------------------------------------------------------------------------
//********************************************************************************

// =========================
// USER
// =========================

model User {
  id              String     @id @default(uuid()) @db.Uuid
  name            String
  email           String     @unique
  passwordHash    String
  status          UserStatus @default(ACTIVE)
  isPlatformAdmin Boolean    @default(false)

  memberships      ClubMembership[]
  examsCreated     Exam[]
  questionsCreated Question[]
  attempts         Attempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("users")
}

// =========================
// CLUB
// =========================

model Club {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  slug         String     @unique
  logoUrl      String?
  description  String?
  collegeName  String
  contactEmail String
  contactPhone String?
  status       ClubStatus @default(PENDING)

  memberships ClubMembership[]
  exams       Exam[]
  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("clubs")
}

// =========================
// CLUB MEMBERSHIP
// =========================

model ClubMembership {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  clubId String @db.Uuid

  role   MembershipRole   @default(MEMBER)
  status MembershipStatus @default(PENDING)

  joinedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, clubId])
  @@index([userId])
  @@index([clubId])
  @@index([clubId, role])
  @@map("club_memberships")
}

// =========================
// Model Exam
// =========================

model Exam {
  id String @id @default(uuid()) @db.Uuid

  clubId      String @db.Uuid
  createdById String @db.Uuid

  title        String
  description  String?
  instructions String?

  durationMinutes Int

  status ExamStatus @default(DRAFT)

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  sessions ExamSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
  @@index([clubId, status])
  @@index([createdById])
  @@map("exams")
}

// =========================
// ExamSession
// =========================

model ExamSession {
  id String @id @default(uuid()) @db.Uuid

  examId String @db.Uuid

  name       String?
  accessMode ExamAccessMode @default(SCHEDULED)

  startTime DateTime?
  endTime   DateTime?

  status ExamSessionStatus @default(SCHEDULED)

  passwordHash String?

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  questions ExamQuestion[]
  attempts  Attempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examId])
  @@index([examId, startTime])
  @@index([status])
  @@map("exam_sessions")
}

//-----

model ExamQuestion {
  id String @id @default(uuid()) @db.Uuid

  examSessionId String @db.Uuid
  questionId    String @db.Uuid

  position Int

  marks         Decimal @db.Decimal(6, 2)
  negativeMarks Decimal @default(0) @db.Decimal(6, 2)

  examSession ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)

  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examSessionId, questionId])
  @@unique([examSessionId, position])
  @@index([examSessionId])
  @@index([questionId])
  @@map("exam_questions")
}

//--------

model Question {
  id String @id @default(uuid()) @db.Uuid

  clubId      String @db.Uuid
  createdById String @db.Uuid

  questionText String

  type       QuestionType
  difficulty QuestionDifficulty @default(MEDIUM)

  explanation String?

  club      Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  options       QuestionOption[]
  answers       Answer[]
  examQuestions ExamQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
  @@index([clubId, type])
  @@index([clubId, difficulty])
  @@index([createdById])
  @@map("questions")
}

//-----------

model QuestionOption {
  id String @id @default(uuid()) @db.Uuid

  questionId String  @db.Uuid
  optionText String
  isCorrect  Boolean @default(false)
  position   Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([questionId, position])
  @@index([questionId])
  @@map("question_options")
}

//---------------------

model Attempt {
  id String @id @default(uuid()) @db.Uuid

  userId        String @db.Uuid
  examSessionId String @db.Uuid

  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  submittedAt DateTime?

  status AttemptStatus @default(IN_PROGRESS)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  examSession ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Restrict)

  answers Answer[]
  result  Result?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([examSessionId])
  @@index([examSessionId, status])
  @@index([userId, status])
  @@map("attempts")
}

//--------------

model Answer {
  id String @id @default(uuid()) @db.Uuid

  attemptId        String  @db.Uuid
  questionId       String  @db.Uuid
  selectedOptionId String? @db.Uuid

  answerText String?

  isCorrect     Boolean?
  marksObtained Decimal? @db.Decimal(6, 2)

  answeredAt DateTime?

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  selectedOption QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: Restrict)


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([selectedOptionId])
  @@map("answers")
}

///-------------------

model Result {
  id String @id @default(uuid()) @db.Uuid

  attemptId String @unique @db.Uuid

  totalQuestions     Int
  attemptedQuestions Int
  correctAnswers     Int
  wrongAnswers       Int

  score      Decimal @db.Decimal(10, 2)
  totalMarks Decimal @db.Decimal(10, 2)
  percentage Decimal @db.Decimal(5, 2)

  rank Int?

  evaluatedAt DateTime @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([score])
  @@index([rank])
  @@map("results")
}
